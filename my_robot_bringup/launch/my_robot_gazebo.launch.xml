<launch>
  <let name="urdf_path" 
       value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"/>
  <let name="gazebo_config_path" 
       value="$(find-pkg-share my_robot_bringup)/config/gazebo_bridge.yaml"/>
  <let name="rviz_config_path" 
       value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>
       
  <!-- Robot State Publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Joint State Publisher (Headless) -->
  <node pkg="joint_state_publisher" exec="joint_state_publisher">
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Gazebo Simulation -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="$(find-pkg-share my_robot_bringup)/worlds/test_world.sdf -r" />
  </include>

  <!-- Spawn Robot -->
  <node pkg="ros_gz_sim" exec="create" args="-topic robot_description"/>

  <!-- ROS-Gazebo Parameter Bridge -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge">
    <param name="config_file" value="$(var gazebo_config_path)"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- RViz2 -->
  <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)">
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- EKF Node -->
  <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen">
    <param from="$(find-pkg-share my_robot_bringup)/config/ekf.yaml" />
    <param name="use_sim_time" value="true"/>
  </node>
</launch>



